{
  "name": "@produtype/core",
  "version": "0.55.0",
  "description": "Deterministic CLI and library that analyzes a web application repository and reports how far it is from production-ready for the kind of product it is meant to be.",
  "license": "MIT",
  "bin": {
    "prodkit": "dist/index.js",
    "prodkit-mcp": "dist/mcp/index.js"
  },
  "main": "dist/api.js",
  "types": "dist/api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js",
      "require": "./dist/api.js",
      "default": "./dist/api.js"
    },
    "./cli": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\"",
    "docs:stacks": "npm run build && node scripts/sync-readme-stacks.mjs",
    "prepare": "npm run build",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run build && node scripts/assert-no-ai.mjs && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^22.20.3",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "typescript": "^5.5.3",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.18",
    "brace-expansion@1": "^1.1.21",
    "brace-expansion@2": "^2.1.7",
    "brace-expansion@3": "^5.0.12",
    "brace-expansion@4": "^5.0.12",
    "brace-expansion@5": "^5.0.12"
  },
  "keywords": [
    "production-readiness",
    "code-analysis",
    "static-analysis",
    "saas",
    "gdpr",
    "security",
    "remediation",
    "mcp",
    "ai-generated-code"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denisbilli/prodkit.git"
  },
  "homepage": "https://github.com/denisbilli/prodkit#readme",
  "bugs": {
    "url": "https://github.com/denisbilli/prodkit/issues"
  },
  "author": "Denis Billi",
  "publishConfig": {
    "access": "public"
  },
  "directories": {
    "test": "tests"
  }
}
